BDI_RUNTIME_DIR=/home/adminuser/buzz-dkg-runtime
BDI_RUNTIME_UID=1000
BDI_RUNTIME_GID=1000
BDI_DKG_TOKEN_PATH=/home/adminuser/dkg-v10/auth.token

BDI_BUZZ_HTTP=https://dkg-v10-mainnet-tracelabs-7.example.ts.net:8443
BDI_BUZZ_WS=wss://dkg-v10-mainnet-tracelabs-7.example.ts.net:8443
BDI_CHANNEL_NAME=Web of Trust
BDI_CHANNEL_VISIBILITY=open
# DKG graph access policy: 1 = private, 0 = public. Publish policy remains 0/off-chain.
BDI_CONTEXT_GRAPH_ACCESS_POLICY=1
BDI_MENTION_HANDLE=dkg
BDI_MENTION_DISPLAY_NAME=DKG Memory

POSTGRES_PASSWORD=generate-a-random-value
REDIS_PASSWORD=generate-a-random-value
BUZZ_S3_ACCESS_KEY=generate-a-random-value
BUZZ_S3_SECRET_KEY=generate-a-random-value
BUZZ_RELAY_PRIVATE_KEY=generate-a-hex64-nostr-key
BDI_BUZZ_OWNER_KEY=generate-a-hex64-nostr-key
BDI_SERVICE_KEY=generate-a-hex64-nostr-key

BDI_PUBLISH_MODE=disabled
BDI_MAX_PUBLISHES_PER_DAY=0
BDI_AUTO_PROVISION_CHANNELS=true
BDI_CONTEXT_GRAPH_ACCESS_POLICY=1

# Optional host-loopback query gateway. The bridge-networked relay service in
# this stack cannot call 127.0.0.1 in the host-networked daemon container; keep
# this disabled unless a trusted host-side authorization front consumes it.
BDI_QUERY_GATEWAY_ENABLED=false
BDI_QUERY_GATEWAY_BIND=127.0.0.1
BDI_QUERY_GATEWAY_PORT=9296
BDI_QUERY_GATEWAY_TOKEN=generate-at-least-32-random-characters
BDI_QUERY_GATEWAY_MAX_BODY_BYTES=262144
BDI_QUERY_GATEWAY_TIMEOUT_MS=120000
BDI_QUERY_GATEWAY_MAX_DKG_CONCURRENT=1
BDI_QUERY_GATEWAY_MAX_DKG_QUEUE=32
BDI_QUERY_GATEWAY_CACHE_TTL_MS=120000
BDI_QUERY_GATEWAY_MAX_CACHE_ENTRIES=256
